<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hob</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HobIntegrationTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);HOB_INTEGRATION_TEST_BUILD</DefineConstants>
    <OutputPath>bin/IntegrationTest/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/IntegrationTest/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
</Project>
