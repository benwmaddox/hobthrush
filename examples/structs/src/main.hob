module example::structs;

pub union Contact { Email(Text), Phone(Text) }
pub struct Address { street: Text, number: i32 }
pub struct User {
    nickname: Option<Text>,
    name: Text,
    address: self::example::structs::Address,
    contact: self::example::structs::Contact,
}

fn display_name(user: self::example::structs::User) -> Text effects {} {
    return match user.nickname {
        Some(nickname) => nickname,
        None => user.name,
    };
}

pub fn main() -> Text effects {} {
    let user: self::example::structs::User = self::example::structs::User {
        contact: self::example::structs::Contact.Email("ada@example.test"),
        address: self::example::structs::Address { number: 221, street: "Baker Street" },
        name: "Ada",
        nickname: Some("Ada Lovelace"),
    };

    return match user.contact {
        self::example::structs::Contact.Email(email) => self::example::structs::display_name(user),
        self::example::structs::Contact.Phone(phone) => user.address.street,
    };
}
