module app::main;

struct Profile { city: Text }
struct GreetingRequest { name: Text, profile: self::app::main::Profile }
struct Greeting { message: Text, profile: self::app::main::Profile }
struct GreetingRow { id: i32, name: Text, city: Text }
struct GreetingLookupParameters { id: i32 }
struct GreetingWriteParameters { id: i32, name: Text, city: Text }
struct NoteWriteRequest { content: Text }

union HomeReply { Page(Html) }
union LookupReply { Found(self::app::main::Greeting), Missing, StorageFailure(Text) }
union CreateReply { Created(self::app::main::Greeting), Invalid(Text), StorageFailure(Text) }
union HealthReply { Healthy }
union FaultReply { Completed }
union ResetReply { Reset }
union NoteWriteReply { Saved, Failed(Text) }

fn load_greeting(db: DbRead) -> Result<Option<self::app::main::GreetingRow>, DbError> effects { db.read } {
    let result: Result<Option<self::app::main::GreetingRow>, DbError> = db.query_one(
        "SELECT id, name, city FROM greeting WHERE id = $id",
        self::app::main::GreetingLookupParameters { id: 1 }
    );
    return result;
}

fn home(db: DbRead) -> self::app::main::HomeReply effects { db.read } {
    let loaded: Result<Option<self::app::main::GreetingRow>, DbError> = self::app::main::load_greeting(db);
    let content: Html = match loaded {
        Ok(value) => match value {
            Some(row) => html.concat(
                html.heading("A safe web page backed by SQLite"),
                html.paragraph(row.name)
            ),
            None => html.concat(
                html.heading("A safe web page backed by SQLite"),
                html.paragraph("No greeting has been saved yet.")
            )
        },
        Err(error) => html.concat(
            html.heading("A safe web page backed by SQLite"),
            html.paragraph("The greeting is temporarily unavailable.")
        )
    };
    let page: Html = html.document("SQLite web example", content);
    return self::app::main::HomeReply.Page(page);
}

fn lookup(db: DbRead) -> self::app::main::LookupReply effects { db.read } {
    let loaded: Result<Option<self::app::main::GreetingRow>, DbError> = self::app::main::load_greeting(db);
    return match loaded {
        Ok(value) => match value {
            Some(row) => self::app::main::LookupReply.Found(self::app::main::Greeting {
                message: row.name,
                profile: self::app::main::Profile { city: row.city }
            }),
            None => self::app::main::LookupReply.Missing
        },
        Err(error) => match error {
            DbError.Statement => self::app::main::LookupReply.StorageFailure("database statement failed"),
            DbError.RowShape => self::app::main::LookupReply.StorageFailure("database row shape is invalid")
        }
    };
}

fn create(request: self::app::main::GreetingRequest, db: DbWrite) -> self::app::main::CreateReply effects { db.write } {
    let normalized: Text = match validation::text::validation::normalize(request.name) {
        Ok(name) => name,
        Err(error) => ""
    };
    if normalized.length == 0 {
        return self::app::main::CreateReply.Invalid("name must contain non-whitespace text");
    }

    let city: Text = request.profile.city.trim();
    if city.length == 0 {
        return self::app::main::CreateReply.Invalid("city must contain non-whitespace text");
    }

    with db.begin() as tx {
        let written: Result<i32, DbError> = tx.execute(
            "INSERT INTO greeting (id, name, city) VALUES ($id, $name, $city) ON CONFLICT(id) DO UPDATE SET name = excluded.name, city = excluded.city",
            self::app::main::GreetingWriteParameters { id: 1, name: normalized, city: city }
        );
        return match written {
            Ok(count) => match tx.commit() {
                Ok(committed) => self::app::main::CreateReply.Created(self::app::main::Greeting {
                    message: normalized,
                    profile: self::app::main::Profile { city: city }
                }),
                Err(error) => match error {
                    DbError.Statement => self::app::main::CreateReply.StorageFailure("database statement failed"),
                    DbError.RowShape => self::app::main::CreateReply.StorageFailure("database row shape is invalid")
                }
            },
            Err(error) => match error {
                DbError.Statement => self::app::main::CreateReply.StorageFailure("database statement failed"),
                DbError.RowShape => self::app::main::CreateReply.StorageFailure("database row shape is invalid")
            }
        };
    }
}

fn health() -> self::app::main::HealthReply effects {} {
    return self::app::main::HealthReply.Healthy;
}

fn fault() -> self::app::main::FaultReply effects {} {
    let crash: i32 = 2147483647 + 1;
    return self::app::main::FaultReply.Completed;
}

fn reset() -> self::app::main::ResetReply effects {} {
    return self::app::main::ResetReply.Reset;
}

async fn save_note(request: self::app::main::NoteWriteRequest, writer: FsWrite) -> self::app::main::NoteWriteReply effects { fs.write } {
    return match await writer.write_text_async("data/async-note.txt", request.content) {
        Ok(written) => self::app::main::NoteWriteReply.Saved,
        Err(error) => self::app::main::NoteWriteReply.Failed("Could not save the note")
    };
}

route GET "/" {
    handler: self::app::main::home;
    response Page: 200 html;
}

route GET "/api/greeting" {
    handler: self::app::main::lookup;
    response Found: 200 json self::app::main::Greeting;
    response Missing: 404;
    response StorageFailure: 500 json Text;
}

route POST "/api/greeting" {
    body: self::app::main::GreetingRequest;
    handler: self::app::main::create;
    response Created: 201 json self::app::main::Greeting;
    response Invalid: 400 json Text;
    response StorageFailure: 500 json Text;
}

route POST "/api/note" {
    body: self::app::main::NoteWriteRequest;
    handler: self::app::main::save_note;
    response Saved: 204;
    response Failed: 500 json Text;
}

route GET "/health" {
    handler: self::app::main::health;
    response Healthy: 200;
}

route GET "/fault" {
    handler: self::app::main::fault;
    response Completed: 200;
}

route GET "/reset" {
    handler: self::app::main::reset;
    response Reset: 205;
}
