module app::scan;

pub async fn run(
    args: self::app::main::ScanArgs,
    fs: FsRead,
) -> Result<Text, self::app::main::ScanError> effects { fs.read } {
    return match await fs.read_text_async(args.input) {
        Ok(contents) => self::app::scan::process_contents(contents, args.normalize, args.first_line),
        Err(error) => Err(self::app::scan::map_fs_error(error)),
    };
}

fn process_contents(
    contents: Text,
    normalize: bool,
    first_line: bool,
) -> Result<Text, self::app::main::ScanError> effects {} {
    if first_line {
        return self::app::scan::first_nonempty_line(contents);
    } else {
        return self::app::scan::normalize_if_requested(contents, normalize);
    }
}

fn first_nonempty_line(contents: Text) -> Result<Text, self::app::main::ScanError> effects {} {
    var selected: Text = "";
    for line in contents.split("\n") {
        let trimmed: Text = line.trim();
        if selected == "" {
            if trimmed != "" {
                selected = trimmed;
            }
        }
    }

    if selected == "" {
        return Err(self::app::main::ScanError.EmptyInput);
    } else {
        return Ok(selected);
    }
}

fn normalize_if_requested(
    contents: Text,
    requested: bool,
) -> Result<Text, self::app::main::ScanError> effects {} {
    if requested {
        return match validation::text::validation::normalize(contents) {
            validation::text::validation::Validation.Valid(normalized) => Ok(normalized.value),
            validation::text::validation::Validation.Invalid(error) => Err(self::app::scan::map_normalize_error(error)),
        };
    } else {
        return Ok(contents);
    }
}

fn map_fs_error(error: FsError) -> self::app::main::ScanError effects {} {
    return match error {
        FsError.NotFound => self::app::main::ScanError.NotFound,
        FsError.PermissionDenied => self::app::main::ScanError.PermissionDenied,
        FsError.InvalidPath => self::app::main::ScanError.InvalidPath,
        FsError.InvalidText => self::app::main::ScanError.InvalidText,
        FsError.Io => self::app::main::ScanError.Io,
    };
}

fn map_normalize_error(
    error: validation::text::validation::NormalizeError,
) -> self::app::main::ScanError effects {} {
    return match error {
        validation::text::validation::NormalizeError.Empty => self::app::main::ScanError.EmptyInput,
        validation::text::validation::NormalizeError.TooLong(max) => self::app::main::ScanError.TooLong,
    };
}

pub fn describe_error(error: self::app::main::ScanError) -> Text effects {} {
    return match error {
        self::app::main::ScanError.NotFound => "File not found",
        self::app::main::ScanError.PermissionDenied => "Permission denied",
        self::app::main::ScanError.InvalidPath => "Invalid file path",
        self::app::main::ScanError.InvalidText => "File is not valid UTF-8",
        self::app::main::ScanError.Io => "File read failed",
        self::app::main::ScanError.EmptyInput => "File contains no text to normalize",
        self::app::main::ScanError.TooLong => "File exceeds the requested maximum length",
    };
}
