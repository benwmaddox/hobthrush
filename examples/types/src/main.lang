module example::types;

pub union Response {
    Accepted(message: Text, valid: bool),
    Rejected(i32),
}

pub union ParseError { Invalid }

pub fn enabled() -> bool effects {} {
    return true;
}

pub fn display(response: self::example::types::Response) -> Text effects {} {
    return match response {
        self::example::types::Response.Accepted(message, valid) => message,
        self::example::types::Response.Rejected(code) => "rejected",
    };
}

pub fn option_text(value: Option<Text>) -> Text effects {} {
    return match value {
        Some(message) => message,
        None => "missing",
    };
}

pub fn result_text(value: Result<Text, self::example::types::ParseError>) -> Text effects {} {
    return match value {
        Ok(message) => message,
        Err(error) => "failed",
    };
}

pub fn absent() -> Option<Text> effects {} {
    return None;
}

pub fn failed() -> Result<Text, self::example::types::ParseError> effects {} {
    return Err(self::example::types::ParseError.Invalid);
}

fn preserves_maximum_octet() -> bool effects {} {
    let first: Bytes = match Bytes.empty().append(255) {
        Ok(bytes) => bytes,
        Err(error) => Bytes.empty(),
    };
    let repeated: Bytes = match Bytes.empty().append(255) {
        Ok(bytes) => bytes,
        Err(error) => Bytes.empty(),
    };
    if first != repeated { return false; }
    return match first.get(0) {
        Some(octet) => octet == 255,
        None => false,
    };
}

pub fn main() -> Text effects {} {
    if self::example::types::preserves_maximum_octet() == false { return "byte value failed"; }
    let is_enabled: bool = self::example::types::enabled();
    let response: self::example::types::Response = self::example::types::Response.Accepted("escaped quote: \"", is_enabled);
    let optional: Option<Text> = Some(self::example::types::display(response));
    let parsed: Result<Text, self::example::types::ParseError> = Ok(self::example::types::option_text(optional));
    let absent_message: Text = self::example::types::option_text(self::example::types::absent());
    let failure_message: Text = self::example::types::result_text(self::example::types::failed());
    return self::example::types::result_text(parsed);
}
