module text::validation;

pub struct Normalized<T> { value: T }

pub union NormalizeError { Empty, TooLong(max: u32) }

pub union Validation<T> { Valid(T), Invalid(self::text::validation::NormalizeError) }

pub trait Normalize {
    fn normalize(input: Self) -> Result<Self, self::text::validation::NormalizeError> effects {};
}

fn normalize_text(input: Text) -> Result<Text, self::text::validation::NormalizeError> effects {} {
    if input.length == 0 {
        return Err(self::text::validation::NormalizeError.Empty);
    }

    return Ok(input.trim());
}

pub impl self::text::validation::Normalize for Text {
    normalize = self::text::validation::normalize_text;
}

pub fn normalize<T: self::text::validation::Normalize>(input: T) -> self::text::validation::Validation<self::text::validation::Normalized<T>> effects {} {
    return match self::text::validation::Normalize.normalize(input) {
        Ok(value) => self::text::validation::Validation<self::text::validation::Normalized<T>>.Valid(
            self::text::validation::Normalized<T> { value: value }
        ),
        Err(error) => self::text::validation::Validation<self::text::validation::Normalized<T>>.Invalid(error),
    };
}

pub fn require<T, E>(value: Option<T>, error: E) -> Result<T, E> effects {} {
    return match value {
        Some(item) => Ok(item),
        None => Err(error),
    };
}

test "generic normalize empty input returns Invalid" {
    let result: self::text::validation::Validation<self::text::validation::Normalized<Text>> = self::text::validation::normalize("");
    assert match result {
        self::text::validation::Validation.Valid(value) => false,
        self::text::validation::Validation.Invalid(error) => match error {
            self::text::validation::NormalizeError.Empty => true,
            self::text::validation::NormalizeError.TooLong(max) => false,
        },
    };
}

test "generic normalize trims nonempty input" {
    let result: self::text::validation::Validation<self::text::validation::Normalized<Text>> = self::text::validation::normalize("  hello  ");
    assert match result {
        self::text::validation::Validation.Valid(value) => value.value == "hello",
        self::text::validation::Validation.Invalid(error) => false,
    };
}

test "Text trim removes surrounding Unicode whitespace" {
    let trimmed: Text = "  \tinside\n ".trim();
    assert trimmed == "inside";
}

test "require preserves a present Option<Text>" {
    let value: Option<Text> = Some("present");
    let result: Result<Text, self::text::validation::NormalizeError> = self::text::validation::require(value, self::text::validation::NormalizeError.Empty);
    assert match result {
        Ok(text) => text == "present",
        Err(error) => false,
    };
}

test "require maps a missing Option<Text> to its error" {
    let value: Option<Text> = None;
    let result: Result<Text, self::text::validation::NormalizeError> = self::text::validation::require(value, self::text::validation::NormalizeError.Empty);
    assert match result {
        Ok(text) => false,
        Err(error) => match error {
            self::text::validation::NormalizeError.Empty => true,
            self::text::validation::NormalizeError.TooLong(max) => false,
        },
    };
}

test "require preserves a TooLong maximum as u32" {
    let max: u32 = 4294967295u32;
    let missing: Option<u32> = None;
    let result: Result<u32, self::text::validation::NormalizeError> = self::text::validation::require(
        missing,
        self::text::validation::NormalizeError.TooLong(max)
    );
    assert match result {
        Ok(value) => false,
        Err(error) => match error {
            self::text::validation::NormalizeError.Empty => false,
            self::text::validation::NormalizeError.TooLong(value) => value == max,
        },
    };
}

test "require preserves a present Option<i32>" {
    let value: Option<i32> = Some(42);
    let result: Result<i32, Text> = self::text::validation::require(value, "missing");
    assert match result {
        Ok(number) => number == 42,
        Err(message) => false,
    };
}

test "require maps a missing Option<i32> to its error" {
    let value: Option<i32> = None;
    let result: Result<i32, Text> = self::text::validation::require(value, "missing");
    assert match result {
        Ok(number) => false,
        Err(message) => message == "missing",
    };
}
