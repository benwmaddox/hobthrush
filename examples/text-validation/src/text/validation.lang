module text.validation;

pub union NormalizeError { Empty }

pub fn normalize(input: Text) -> Result<Text, NormalizeError> effects {} {
    if input.length == 0 {
        return Err(NormalizeError.Empty);
    }

    return Ok(input.trim());
}

pub fn require<T, E>(value: Option<T>, error: E) -> Result<T, E> effects {} {
    return match value {
        Some(item) => Ok(item),
        None => Err(error),
    };
}
