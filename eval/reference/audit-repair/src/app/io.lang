module app::io;

pub async fn read_text(fs: FsRead, path: FilePath) -> Result<Text, self::app::main::ReadFailure> effects { fs.read } {
    return match await fs.read_text_async(path) {
        Ok(contents) => Ok(contents),
        Err(error) => Err(self::app::main::ReadFailure.Unavailable),
    };
}
