module fixture::valid_structs;

pub union Route { Home, Page(Text) }
pub struct Link { next: Option<self::fixture::valid_structs::Link>, route: self::fixture::valid_structs::Route }

pub fn route_value(link: self::fixture::valid_structs::Link) -> i32 effects {} {
    return match link.route {
        self::fixture::valid_structs::Route.Home => 0,
        self::fixture::valid_structs::Route.Page(name) => 1,
    };
}

pub fn empty_link() -> self::fixture::valid_structs::Link effects {} {
    return self::fixture::valid_structs::Link { route: self::fixture::valid_structs::Route.Home, next: None };
}
