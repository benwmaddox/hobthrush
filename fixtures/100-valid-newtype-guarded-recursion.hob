pub fn branch(value: i32) -> self::fixture::valid_newtype_guarded_recursion::TreeRoot effects {} {
    return self::fixture::valid_newtype_guarded_recursion::TreeRoot.wrap(
        self::fixture::valid_newtype_guarded_recursion::Tree.Branch([
            self::fixture::valid_newtype_guarded_recursion::Tree.Leaf(value)]));
}

pub fn same_tree(left: self::fixture::valid_newtype_guarded_recursion::TreeRoot, right: self::fixture::valid_newtype_guarded_recursion::TreeRoot) -> bool effects {} {
    return left == right;
}

