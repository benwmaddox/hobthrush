pub fn same_chain(left: self::fixture::valid_newtype_guarded_recursion::Chain, right: self::fixture::valid_newtype_guarded_recursion::Chain) -> bool effects {} {
    return left == right;
}

pub fn leaf(value: i32) -> self::fixture::valid_newtype_guarded_recursion::TreeRoot effects {} {
    return self::fixture::valid_newtype_guarded_recursion::TreeRoot.wrap(
        self::fixture::valid_newtype_guarded_recursion::Tree.Leaf(value));
