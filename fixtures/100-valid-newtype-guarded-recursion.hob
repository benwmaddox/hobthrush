module fixture::valid_newtype_guarded_recursion;

pub newtype Chain = Option<self::fixture::valid_newtype_guarded_recursion::Chain>;

pub union Tree {
    Leaf(i32),
    Branch(List<self::fixture::valid_newtype_guarded_recursion::Tree>),
}

pub newtype TreeRoot = self::fixture::valid_newtype_guarded_recursion::Tree;

pub fn empty_chain() -> self::fixture::valid_newtype_guarded_recursion::Chain effects {} {
    return self::fixture::valid_newtype_guarded_recursion::Chain.wrap(None);
}

pub fn nested_chain() -> self::fixture::valid_newtype_guarded_recursion::Chain effects {} {
    return self::fixture::valid_newtype_guarded_recursion::Chain.wrap(
        Some(self::fixture::valid_newtype_guarded_recursion::empty_chain()));
