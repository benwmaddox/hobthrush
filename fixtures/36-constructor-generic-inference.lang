module fixture::constructor_generic_inference;

pub fn require<T, E>(value: Option<T>, error: E) -> Result<T, E> effects {} {
    return match value {
        Some(item) => Ok(item),
        None => Err(error),
    };
}

pub fn direct_some() -> Result<Text, Text> effects {} {
    return self::fixture::constructor_generic_inference::require(Some("present"), "fallback");
}
