module fixture::unit_values;

pub struct Holder<T> { item: T }
pub union Wrapped<T> { Empty, Present(T) }
pub struct Unit { value: i32 }

fn empty() -> Unit effects {} { return (); }
fn keep(value: Unit) -> Unit effects {} { return value; }
fn identity<T>(value: T) -> T effects {} { return value; }

pub fn main() -> i32 effects {} {
    let one: Unit = ();
    let from_empty: Unit = self::fixture::unit_values::empty();
    let from_argument: Unit = self::fixture::unit_values::keep(());
    let nested: Unit = ((()));
    let grouped: i32 = (1 + 2);
    let nested_grouped: i32 = ((1 + 2));
    let copied: Unit = self::fixture::unit_values::identity(());

    let units: List<Unit> = [one, nested];
    let units_copy: List<Unit> = units;
    let some: Option<Unit> = Some(());
    let some_copy: Option<Unit> = some;
    let ok: Result<Unit, Text> = Ok(());
    let ok_copy: Result<Unit, Text> = ok;
    let holder: self::fixture::unit_values::Holder<Unit> =
        self::fixture::unit_values::Holder<Unit> { item: () };
    let holder_copy: self::fixture::unit_values::Holder<Unit> = holder;
    let wrapped: self::fixture::unit_values::Wrapped<Unit> =
        self::fixture::unit_values::Wrapped<Unit>.Present(());
    let wrapped_copy: self::fixture::unit_values::Wrapped<Unit> = wrapped;
    let nominal: self::fixture::unit_values::Unit =
        self::fixture::unit_values::Unit { value: 3 };
    let nominal_copy: self::fixture::unit_values::Unit = nominal;

    if one != from_empty { return 1; }
    if one != from_argument { return 1; }
    if one != copied { return 1; }
    if one != self::fixture::unit_values::keep(nested) { return 1; }
    if units != units_copy { return 1; }
    if some != some_copy { return 1; }
    if ok != ok_copy { return 1; }
    if holder != holder_copy { return 1; }
    if wrapped != wrapped_copy { return 1; }
    if nominal != nominal_copy { return 1; }
    if grouped != 3 { return 1; }
    if nested_grouped != 3 { return 1; }
    return 0;
}
