module fixture::invalid_immutable_bytes_basics;

struct Bytes { value: i32 }

fn invalid(value: Bytes) -> Bytes effects {} {
    let wrong_arity: Bytes = Bytes.empty(1);
    let wrong_append: Result<Bytes, BytesError> = value.append(true);
    let wrong_get: Option<i32> = value.get("first");
    let missing_append: Result<Bytes, BytesError> = value.append();
    let called_length: i32 = value.length();
    let unknown_member: i32 = value.to_text();
    let unknown_field: i32 = value.octets;
    let parameterized: Bytes<i32> = Bytes.empty();
    let forged: BytesError = BytesError.InvalidOctet;
    let forged_call: BytesError = BytesError.InvalidOctet();
    let unknown_variant: BytesError = BytesError.Missing;
    let unknown_constructor: BytesError = BytesError.Missing();
    return value;
}

